        <script><![CDATA[(function executeRule() {
    var now = new GlideDateTime();
    var gr = new GlideRecord('x_1809800_event_0_event_booking'); // replace table name
    // Bookings that are not yet marked No Show
    gr.addQuery('status', '!=', 'confirmed'); 
    // Start time + 15 min already passed
    gr.addEncodedQuery('start_dateRELATIVELT@minute@ago@15');
    // No check-in recorded
    gr.addNullQuery('check_in_time'); 
    gr.query();
    while (gr.next()) {
        gr.status = 'confirmed'; 
        gr.update();
    }
})();
