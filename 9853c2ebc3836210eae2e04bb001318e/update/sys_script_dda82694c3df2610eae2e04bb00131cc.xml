        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var newStartDate = new GlideDateTime(current.start_date).getDate().toString(); // 'yyyy-MM-dd'
    var newEndDate = new GlideDateTime(current.end_date).getDate().toString();

    var gr = new GlideRecord('x_1809800_event_0_event_booking');
    gr.addQuery('sys_id', '!=', current.sys_id); // Exclude current record
    gr.addQuery('room', current.room); // Check same room

    // Check date overlap: existing.start_date <= newEnd AND existing.end_date >= newStart
    gr.addEncodedQuery("start_date<=" + newEndDate + "^end_date>=" + newStartDate);

    gr.query();

    if (gr.hasNext()) {
        gs.addErrorMessage("Booking overlaps with an existing booking for the same room.");
        current.setAbortAction(true);
    }


})(current, previous);]]></script>
