        <script><![CDATA[(function executeRule(current, previous /*null for async*/) {
  var now = new GlideDateTime();
  // Validate Start is not in the past
  if (current.start_datetime < now) {
    gs.addErrorMessage("Maintenance cannot start in the past.");
    current.setAbortAction(true);
    return;
  }

  // Validate End is after Start
  if (current.end_datetime <= current.start_datetime) {
    gs.addErrorMessage("End time must be after start time.");
    current.setAbortAction(true);
    return;
  }
})(current,previous);
]]></script>
