        <name>KAPGetLastBookingDaysAgo</name>
        <order/>
        <script><![CDATA[function onLoad() {
  var ga = new GlideAjax('KAPGetLastBookingDaysAgo');
  ga.addParam('sysparm_name', 'getDaysSinceLastBooking');
  ga.getXMLAnswer(function(response) {
    var days = parseInt(response, 10); // Ensure it's a number
	alert(days);
    if (days === -1) {
      g_form.addInfoMessage("You have not booked any rooms yet.");
    } else if (days === 0) {
      g_form.addInfoMessage("You booked a room today.");
    } else if (days === 1) {
      g_form.addInfoMessage("You booked a room 1 day ago.");
    } else {
      g_form.addInfoMessage("You booked a room " + days + " days ago.");
    }
  });
}]]></script>
